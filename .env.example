# ENVIRONMENT CONTROL
NODE_ENV=development

# ROOT ADMIN CREDENTIALS (Only used for cluster setup)
POSTGRES_PASSWORD=super_secure_admin_root_password

# LOW-PRIVILEGE WORKER CREDENTIALS (Used by your Node.js API)
DB_NAME=ecommerce_platform
DB_USER=store_api_worker
DB_PASSWORD=super_secure_store_password
DB_PORT=5432

# PGADMIN MANAGEMENT CREDENTIALS (Web Panel GUI Admin Login)
PGADMIN_DEFAULT_EMAIL=admin@ecommerce.com
PGADMIN_DEFAULT_PASSWORD=super_secure_pgadmin_password

# SECURITY KEY SYNC
JWT_SECRET=my_super_secret_developer_token_handshake_key_123!
